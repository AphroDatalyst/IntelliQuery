# Copy to .env and adjust. Every variable is read with the INTELLIQUERY_ prefix.

INTELLIQUERY_ENVIRONMENT=local
INTELLIQUERY_LOG_LEVEL=INFO
INTELLIQUERY_LOG_JSON=false

# PostgreSQL with the pgvector extension.
INTELLIQUERY_DATABASE_URL=postgresql+asyncpg://intelliquery:intelliquery@localhost:5432/intelliquery

# Used by compose.yaml to provision the database container.
POSTGRES_USER=intelliquery
POSTGRES_PASSWORD=intelliquery
POSTGRES_DB=intelliquery

# Host port the API is published on.
API_PORT=8000

# --- Models -----------------------------------------------------------------
# Any endpoint that implements the OpenAI-compatible HTTP API works, hosted or
# local. The defaults target Ollama on this machine.
#
# The embedding model must return 1024-dimensional vectors (for example bge-m3).
# For models with a configurable size, set INTELLIQUERY_EMBEDDING_REQUEST_DIMENSIONS=true.
INTELLIQUERY_EMBEDDING_BASE_URL=http://localhost:11434/v1
INTELLIQUERY_EMBEDDING_MODEL=bge-m3
# INTELLIQUERY_EMBEDDING_API_KEY=
# INTELLIQUERY_EMBEDDING_REQUEST_DIMENSIONS=false

# Vision model that describes figures. Leave the model unset to skip figure
# description; figures are then searchable by their printed caption only.
INTELLIQUERY_VISION_BASE_URL=http://localhost:11434/v1
# INTELLIQUERY_VISION_MODEL=
# INTELLIQUERY_VISION_API_KEY=

# --- Ingestion --------------------------------------------------------------
INTELLIQUERY_STORAGE_DIR=data/storage
# Enable for scanned PDFs that have no text layer.
INTELLIQUERY_INGEST_OCR=false
